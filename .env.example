# KITE OS research server (server-side only; never prefix these with VITE_).
# Copy to .env and fill in. .env is git-ignored.

# Required for "Gerçek Araştırma". Without it, demo mode still works.
# KITE uses its own variable on purpose: the generic ANTHROPIC_API_KEY is ignored so it can never
# affect (or be affected by) Claude Code or other tools on the same machine.
KITE_ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5-5. The generic ANTHROPIC_MODEL is ignored (Claude Code uses it).
# KITE_ANTHROPIC_MODEL=claude-opus-5-5

# Persistent data (companies, research history, mail drafts). SQLite file used only by the server.
# Defaults to data/kite.db in the project (git ignored). Relative paths resolve from the project root.
# Back it up while the server is stopped (see README). Never commit it.
# KITE_DB_PATH=data/kite.db

# Optional server settings.
# PORT=8787
# RESEARCH_MAX_COMPANIES=20        # hard cap per real research job (max 20)
# RESEARCH_MAX_SEARCHES=8          # web searches per discovery (max 15)
# RESEARCH_MAX_EXTRA_PAGES=3       # pages fetched per company besides the homepage (max 5)
# RESEARCH_FETCH_TIMEOUT_MS=8000
# RESEARCH_DISCOVERY_EFFORT=medium # low | medium | high
# RESEARCH_ANALYSIS_EFFORT=medium

# Offline test data instead of the real provider (labelled as test data in the UI).
# RESEARCH_PROVIDER=fixture
